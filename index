const singleInput = document.getElementById('singleInput');
const singleBtn = document.getElementById('singleBtn');
const singleResult = document.getElementById('singleResult');

function doSingleSearch() {
    const name = singleInput.value.trim();
    if (!name) return;
    const exact = [...Object.keys(recipes), ...baseElements].find(
        n => n.toLowerCase() === name.toLowerCase()
    );
    if (!exact) {
        singleResult.classList.add('active');
        singleResult.innerHTML = `<div class="notfound">❌ Элемент "${escapeHtml(name)}" не найден в базе.</div>`;
        return;
    }

    const chain = getChain(exact);
    singleResult.classList.add('active');

    if (!chain) {
        singleResult.innerHTML = `<div class="head"><h2>⚗️ ${escapeHtml(exact)}</h2></div>
            <div class="notfound">⭐ Базовый элемент (не требует синтеза)</div>`;
        return;
    }

    renderTree(singleResult, chain, [exact], `⚗️ ${exact}`);
}

singleBtn.addEventListener('click', doSingleSearch);
singleInput.addEventListener('keydown', e => { if (e.key === 'Enter') doSingleSearch(); });

// ============================================================
//  Вкладка 2
// ============================================================
const multiBtn = document.getElementById('multiBtn');
const multiClearBtn = document.getElementById('multiClearBtn');
const multiResult = document.getElementById('multiResult');

multiBtn.addEventListener('click', () => {
    const inputs = multiInputsEl.querySelectorAll('input');
    const requested = [];
    inputs.forEach(inp => {
        const v = inp.value.trim();
        if (v) requested.push(v);
    });

    if (requested.length === 0) {
        multiResult.classList.add('active');
        multiResult.innerHTML = `<div class="notfound">Введите хотя бы один элемент</div>`;
        return;
    }

    const allNames = [...Object.keys(recipes), ...baseElements];
    const exactTargets = [];
    const notFound = [];
    requested.forEach(name => {
        const found = allNames.find(n => n.toLowerCase() === name.toLowerCase());
        if (found) {
            if (!exactTargets.includes(found)) exactTargets.push(found);
        } else {
            notFound.push(name);
        }
    });

    if (exactTargets.length === 0) {
        multiResult.classList.add('active');
        multiResult.innerHTML = `<div class="notfound">Ни одного элемента не найдено: ${notFound.map(escapeHtml).join(', ')}</div>`;
        return;
    }

    const targetsWithChains = exactTargets.map(t => ({ name: t, chain: getChain(t) || [] }));
    targetsWithChains.sort((a, b) => a.chain.length - b.chain.length);

    const mergedSteps = [];
    const known = new Set([...baseElements, "Время"]);
    for (const tgt of targetsWithChains) {
        for (const step of tgt.chain) {
            if (!known.has(step[2])) {
                mergedSteps.push(step);
                known.add(step[2]);
            }
        }
    }

    const sortedTargetNames = targetsWithChains.map(t => t.name);

    multiResult.classList.add('active');
    renderTree(multiResult, mergedSteps, sortedTargetNames, `🌳 Единое дерево (${sortedTargetNames.length} целей)`);

    if (notFound.length) {
        const h = multiResult.querySelector('.head');
        if (h) h.insertAdjacentHTML('afterend', `<div class="notfound" style="color:#ffa657;padding:8px 0;font-size:0.88rem;">⚠️ Не найдены: ${notFound.map(escapeHtml).join(', ')}</div>`);
    }
});

multiClearBtn.addEventListener('click', () => {
    multiInputsEl.querySelectorAll('input').forEach(inp => inp.value = '');
    multiResult.classList.remove('active');
    multiResult.innerHTML = '';
});

window.addEventListener('DOMContentLoaded', () => {
    singleInput.value = 'Хомяк';
    doSingleSearch();
});
