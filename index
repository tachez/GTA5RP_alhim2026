    .badge.base {
        background: #0f2a17; color: #7ee787; border: 1px solid #7ee78755;
    }
    .badge.time {
        background: #2d1f0e; color: #ffa657; border: 1px solid #ffa65755;
    }

    .notfound {
        color: #f85149; text-align: center;
        padding: 24px 0; font-size: 1rem;
