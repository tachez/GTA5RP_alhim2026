// ============================================================
//  Рендер дерева
// ============================================================
function renderTree(container, steps, targets, titleText) {
    let done = 0;
    const total = steps.length;

    const chipsHtml = targets.map((t, idx) => {
        const chain = getChain(t);
        const len = chain ? chain.length : 0;
        return `<span class="chip" data-target="${escapeAttr(t)}"><span class="order">#${idx+1}</span>★ ${escapeHtml(t)} <span class="len">(${len} шаг.)</span></span>`;
    }).join('');

    container.innerHTML = `
        <div class="head">
            <h2>${escapeHtml(titleText)}</h2>
            <div class="info">Шагов: <span class="limit" id="limitInfo">${total}</span></div>
        </div>
        <div class="targets-chips">${chipsHtml}</div>
        <div class="progress">
            <span class="txt">Выполнено: <span class="done" id="doneCount">0</span> / <span class="total">${total}</span></span>
            <div class="bar"><div class="bar-fill" id="barFill"></div></div>
            <button data-act="all">✅ Все</button>
            <button data-act="none">⬜ Снять</button>
        </div>
        <div class="steps" id="stepsBox"></div>
    `;

    const stepsBox = container.querySelector('#stepsBox');
    let html = '';
    steps.forEach(([a, b, result, type], i) => {
        const num = i + 1;
        const isT = targets.includes(result);
        let extra = '';
        if (type === 'time') extra = '<span class="badge time">⏰ ВРЕМЯ</span>';
        else if (isT) extra = '<span class="badge">★ ЦЕЛЬ</span>';
        html += `<div class="step-row${isT ? ' target' : ''}" data-step="${num}" data-result="${escapeAttr(result)}" data-target="${isT ? '1' : '0'}">
            <input type="checkbox" data-step="${num}" data-result="${escapeAttr(result)}" data-target="${isT ? '1' : '0'}">
            <span class="num">#${num}</span>
            <span class="formula">
                <span class="ing">${escapeHtml(a)}</span>
                <span class="op">+</span>
                <span class="ing">${escapeHtml(b)}</span>
                <span class="op">=</span>
                <span class="res">${escapeHtml(result)}</span>
            </span>
            ${extra}
        </div>`;
    });
    stepsBox.innerHTML = html;

    stepsBox.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        cb.addEventListener('change', function () {
            const row = this.closest('.step-row');
            if (this.checked) row.classList.add('done');
            else row.classList.remove('done');
            updateProgress(container, targets);
        });
    });

    container.querySelectorAll('.progress button').forEach(btn => {
        btn.addEventListener('click', () => {
            const act = btn.dataset.act;
            stepsBox.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                cb.checked = (act === 'all');
                const row = cb.closest('.step-row');
                if (act === 'all') row.classList.add('done');
                else row.classList.remove('done');
            });
            updateProgress(container, targets);
        });
    });

    updateProgress(container, targets);

    const limitEl = container.querySelector('#limitInfo');
    if (total > 95) limitEl.classList.add('warn');
}

function updateProgress(container, targets) {
    const stepsBox = container.querySelector('#stepsBox');
    const allBoxes = stepsBox.querySelectorAll('input[type="checkbox"]');
    const doneCount = Array.from(allBoxes).filter(cb => cb.checked).length;
    const total = allBoxes.length;
    container.querySelector('#doneCount').textContent = doneCount;
    const fill = container.querySelector('#barFill');
    if (fill) fill.style.width = total ? (doneCount / total * 100) + '%' : '0%';

    container.querySelectorAll('.chip').forEach(chip => {
        const tgt = chip.dataset.target;
        const cb = stepsBox.querySelector(`input[type="checkbox"][data-result="${escapeAttr(tgt)}"][data-target="1"]`);
        if (cb && cb.checked) chip.classList.add('done');
        else chip.classList.remove('done');
    });
}

function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(s) { return escapeHtml(s); }

