        border-bottom: 1px solid #30363d; padding-bottom: 0;
    }
    .tab {
        padding: 12px 24px; cursor: pointer;
        background: transparent; border: none;
        color: #8b949e; font-size: 1rem; font-weight: 600;
        border-bottom: 3px solid transparent;
        transition: 0.2s; font-family: inherit;
    }
    .tab:hover { color: #e6edf3; }
    .tab.active {
        color: #ffd200; border-bottom-color: #ffd200;
    }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .input-panel {
        background: #161b22; border-radius: 16px;
        padding: 20px 25px; border: 1px solid #30363d;
        margin-bottom: 20px;
    }
    .input-panel h2 {
        font-size: 1rem; color: #ffd200; margin-bottom: 12px;
    }
    .single-input-row {
        display: flex; gap: 10px; flex-wrap: wrap;
    }
    .single-input-row input {
        flex: 1; padding: 12px 18px; border-radius: 10px;
        border: 1px solid #30363d; background: #0d1117;
        color: #e6edf3; font-size: 1.05rem; outline: none;
        min-width: 180px; transition: 0.2s;
    }
    .single-input-row input:focus {
        border-color: #f7971e;
        box-shadow: 0 0 0 3px rgba(247,151,30,0.15);
    }
    .single-input-row button {
        padding: 12px 28px; border-radius: 10px; border: none;
        background: linear-gradient(135deg, #f7971e, #ffd200);
        color: #0d1117; font-weight: 700; font-size: 1rem;
        cursor: pointer; transition: 0.2s; white-space: nowrap;
        font-family: inherit;
    }
    .single-input-row button:hover { transform: scale(1.03); }
    .single-input-row button.ghost {
        background: #21262d; color: #e6edf3;
        border: 1px solid #30363d;
    }
    .single-input-row button.ghost:hover {
        border-color: #f7971e; transform: none;
    }

    .multi-inputs {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 10px; margin-bottom: 14px;
    }
    .multi-inputs input {
        padding: 10px 14px; border-radius: 10px;
        border: 1px solid #30363d; background: #0d1117;
        color: #e6edf3; font-size: 0.95rem; outline: none;
        transition: 0.2s;
    }
    .multi-inputs input:focus {
        border-color: #f7971e;
        box-shadow: 0 0 0 3px rgba(247,151,30,0.15);
    }

    .actions-row {
        display: flex; gap: 10px; flex-wrap: wrap;
        margin-top: 4px;
    }
    .actions-row button {
        padding: 10px 22px; border-radius: 10px; border: none;
        background: linear-gradient(135deg, #f7971e, #ffd200);
        color: #0d1117; font-weight: 700; font-size: 0.95rem;
        cursor: pointer; transition: 0.2s;
        font-family: inherit;
    }
    .actions-row button:hover { transform: scale(1.03); }
    .actions-row button.ghost {
        background: #21262d; color: #e6edf3;
        border: 1px solid #30363d;
    }
    .actions-row button.ghost:hover { border-color: #f7971e; transform: none; }

    .result {
        background: #161b22; border-radius: 16px;
        padding: 20px 25px; border: 1px solid #30363d;
        display: none;
    }
    .result.active { display: block; animation: fadeIn 0.35s ease; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .result .head {
        display: flex; justify-content: space-between;
        align-items: center; flex-wrap: wrap;
        margin-bottom: 14px; gap: 10px;
    }
    .result .head h2 { font-size: 1.2rem; color: #ffd200; }
    .result .head .info { color: #8b949e; font-size: 0.85rem; }
    .result .head .limit { color: #7ee787; font-size: 0.85rem; font-weight: 700; }
    .result .head .limit.warn { color: #f85149; }

    .targets-chips {
        display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px;
    }
    .chip {
        font-size: 0.78rem; padding: 3px 12px; border-radius: 14px;
        background: #2d2410; border: 1px solid #ffd20066;
        color: #ffd200;
    }
    .chip.done { background: #0f2a17; border-color: #7ee787; color: #7ee787; }
    .chip .order { color: #8b949e; font-weight: 700; margin-right: 4px; }
    .chip .len { color: #8b949e; font-size: 0.7rem; }

    .progress {
        background: #0d1117; border-radius: 10px;
        padding: 12px 16px; margin-bottom: 16px;
        border: 1px solid #30363d;
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .progress .txt { color: #8b949e; font-size: 0.88rem; white-space: nowrap; }
    .progress .txt .done { color: #7ee787; font-weight: 700; }
    .progress .txt .total { color: #ffd200; font-weight: 700; }
    .progress .bar {
        flex: 1; min-width: 120px; height: 8px;
        background: #21262d; border-radius: 5px; overflow: hidden;
    }
    .progress .bar-fill {
        height: 100%; width: 0%;
        background: linear-gradient(90deg, #f7971e, #ffd200);
        transition: width 0.3s ease;
    }
    .progress button {
        padding: 5px 12px; border-radius: 7px;
        border: 1px solid #30363d; background: #161b22;
        color: #e6edf3; cursor: pointer; font-size: 0.78rem;
        transition: 0.2s; font-family: inherit;
    }
    .progress button:hover { border-color: #f7971e; }

    .steps { display: flex; flex-direction: column; gap: 3px; }
    .step-row {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 12px; border-radius: 10px;
        font-size: 0.95rem; transition: 0.15s;
        border-left: 3px solid transparent;
        flex-wrap: wrap;
    }
    .step-row:hover { background: #1c2333; }
    .step-row.done { border-left-color: #7ee787; background: #0f1a12; }
    .step-row.done .formula,
    .step-row.done .num { opacity: 0.55; }
    .step-row.target {
        border: 1px solid #ffd200; border-left: 3px solid #ffd200;
        background: linear-gradient(90deg, #2d2410 0%, #161b22 60%);
        box-shadow: 0 0 0 1px #ffd20033, 0 0 18px #ffd20022;
        margin: 5px 0; padding: 10px 12px;
    }
    .step-row.target.done {
        border-color: #7ee787; border-left-color: #7ee787;
        background: linear-gradient(90deg, #0f2a17 0%, #0f1a12 60%);
        box-shadow: 0 0 0 1px #7ee78755, 0 0 18px #7ee78722;
    }
    .step-row input[type="checkbox"] {
        width: 16px; height: 16px; accent-color: #f7971e;
        cursor: pointer; flex-shrink: 0;
    }
    .step-row .num {
        color: #8b949e; font-size: 0.76rem; font-weight: 700;
        min-width: 36px; text-align: right;
        font-variant-numeric: tabular-nums;
    }
    .step-row.target .num { color: #ffd200; }
    .step-row.target.done .num { color: #7ee787; }
    .step-row .formula {
        display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
    }
    .el { border-bottom: 1px dashed transparent; }
    .ing { color: #58a6ff; font-weight: 500; }
    .res { color: #ffd200; font-weight: 700; }
    .step-row.target .res { text-shadow: 0 0 10px #ffd20066; }
    .op { color: #8b949e; font-weight: 600; margin: 0 2px; }
    .badge {
        font-size: 0.66rem; font-weight: 800;
