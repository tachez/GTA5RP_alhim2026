const baseElements = ["Воздух", "Земля", "Пламя", "Вода"];

// ============================================================
//  Построение дерева
// ============================================================
function buildTree(element, visited = new Set(), depth = 0) {
    if (depth > 80) return null;
    if (visited.has(element)) return null;
    if (baseElements.includes(element)) return { type: 'base', name: element };
    if (element === "Время") return { type: 'time', name: 'Время' };
    const recipe = recipes[element];
    if (!recipe) return { type: 'base', name: element };
    visited.add(element);
    const [a, b] = recipe;
    const left = buildTree(a, new Set(visited), depth + 1);
    const right = buildTree(b, new Set(visited), depth + 1);
    visited.delete(element);
    if (!left || !right) return null;
    return { type: 'recipe', name: element, left, right, direct: [a, b] };
}

function flatten(node, steps = []) {
    if (!node || node.type === 'base' || node.type === 'time') return steps;
    flatten(node.left, steps);
    flatten(node.right, steps);
    steps.push([node.direct[0], node.direct[1], node.name, node.type]);
    return steps;
}

function getChain(element) {
    const tree = buildTree(element);
    if (!tree) return null;
    const steps = flatten(tree);
    const seen = new Set();
    const unique = [];
    for (const s of steps) {
        if (!seen.has(s[2])) { seen.add(s[2]); unique.push(s); }
    }
    return unique;
}

